const MOEDA_STORAGE_KEY = 'poe2_craft_moeda_ref';

// ============================================================
// API — CARREGAR PREÇOS
// ============================================================
async function carregarPrecos() {
    const statusDot = document.getElementById('statusDot');
    const statusText = document.getElementById('statusText');
    const btnRefresh = document.getElementById('btnRefresh');

    statusDot.className = 'status-dot loading';
    statusText.textContent = 'Carregando preços do poe.ninja...';
    btnRefresh.disabled = true;

    const targetUrl = 'https://poe.ninja/poe2/api/economy/exchange/current/overview?league=Forbidden%20Rites&type=Currency';
    const proxies = [
        `https://corsproxy.io/?${encodeURIComponent(targetUrl)}`,
        `https://api.allorigins.win/raw?url=${encodeURIComponent(targetUrl)}`,
        `https://thingproxy.freeboard.io/fetch/${targetUrl}`
    ];

    let dados = null;
    for (const url of proxies) {
        try {
            const r = await fetch(url);
            if (!r.ok) throw new Error(`HTTP ${r.status}`);
            dados = await r.json();
            break;
        } catch (e) {
            console.warn('[Proxy] falhou:', e.message);
        }
    }

    if (!dados) {
        statusDot.className = 'status-dot';
        statusText.textContent = 'Usando dados locais (offline)';
        btnRefresh.disabled = false;
        usarDadosFallback();
        return;
    }

    try {
        processarDados(dados);
        statusDot.className = 'status-dot online';
        statusText.textContent = `${Object.keys(precos).length} orbes carregados`;
        document.getElementById('lastUpdate').textContent =
            `Atualizado: ${new Date().toLocaleTimeString('pt-BR')}`;
        precosCarregados = true;
        btnRefresh.disabled = false;
        recalcularTudo();
    } catch (e) {
        console.error(e);
        usarDadosFallback();
        btnRefresh.disabled = false;
    }
}

function processarDados(dados) {
    precos = {};

    if (dados.lines && dados.items) {
        const itemsMap = {};
        if (Array.isArray(dados.items)) {
            dados.items.forEach(i => itemsMap[i.id] = i.name);
        } else {
            Object.entries(dados.items).forEach(([id, i]) => {
                itemsMap[id] = i.name || i;
            });
        }
        const primary = (dados.core && dados.core.primary) || 'Exalted Orb';
        dados.lines.forEach(line => {
            const nome = line.id || itemsMap[line.id];
            if (nome && line.primaryValue !== undefined) {
                precos[nome] = { value: line.primaryValue, currency: primary };
            }
        });
    } else if (dados.lines && dados.currencyDetails) {
        dados.lines.forEach(line => {
            const nome = line.currencyTypeName;
            if (nome && line.chaosEquivalent !== undefined) {
                precos[nome] = { value: line.chaosEquivalent, currency: 'Chaos Orb' };
            }
        });
    }
}

